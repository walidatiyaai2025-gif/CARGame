# Copy this file to android/key.properties. The real file is ignored by Git.
# Keep signing material outside source control and use an absolute or android-relative keystore path.
storeFile=C:/secure/path/upload-keystore.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME

# Alternative: omit android/key.properties and set all four environment variables:
# ANDROID_KEYSTORE_PATH
# ANDROID_KEYSTORE_PASSWORD
# ANDROID_KEY_ALIAS
# ANDROID_KEY_PASSWORD
